<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Display name only. CFBundleExecutable, CFBundleIdentifier and the
	     bundle's filename on disk deliberately stay "Flow" /
	     com.matsumedia.flow: macOS keys Accessibility, Input Monitoring and
	     Microphone grants to the identifier, the path and the signature, so
	     renaming any of those would silently reset every permission and orphan
	     the API key in the Keychain. -->
	<key>CFBundleName</key>
	<string>Free Flow</string>
	<key>CFBundleDisplayName</key>
	<string>Free Flow</string>
	<key>CFBundleIdentifier</key>
	<string>com.matsumedia.flow</string>
	<key>CFBundleExecutable</key>
	<string>Flow</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.3.0</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>

	<key>CFBundleIconFile</key>
	<string>AppIcon</string>

	<!-- Not an LSUIElement: Flow shows in the Dock by default so it's easy to
	     find. The Dock/menu-bar choice is a setting, applied at runtime via
	     NSApplication.setActivationPolicy. -->

	<key>NSMicrophoneUsageDescription</key>
	<string>Flow listens while you hold your dictation key, and transcribes your speech on-device.</string>

	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
